# Public site origin used in emails and canonical URLs
VITE_SITE_URL=https://alignaa.co

# Keep true until the project owner approves public launch
VITE_DRAFT_MODE=true

# Hosted form endpoint (Formspree, Web3Forms, or a small secure function)
# Leave empty until configured. The site must not pretend an email was sent.
VITE_FORM_ENDPOINT=

# Optional access key for services such as Web3Forms. Never commit real secrets
# that belong only on a private backend. Public form keys should be restricted
# by domain in the provider dashboard.
VITE_FORM_ACCESS_KEY=
